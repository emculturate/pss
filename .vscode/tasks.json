{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "mavenTestSelector",
      "type": "promptString",
      "description": "Maven test selector (Class or Class#method)",
      "default": "SqlEventWalkerSubqueriesAndClauseSemanticsTests#unaliasedDerivedSimpleAllOuterClausesV1Test"
    }
  ],
  "tasks": [
    {
      "label": "Prime Parse Build Model",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Dmaven.compiler.showWarnings=false",
        "-DskipTests",
        "test-compile"
      ],
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Recover Java Model Now",
      "type": "shell",
      "command": "bash",
      "args": [
        "tools/recover-java-model.sh"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run All Tests (Maven)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Pisolated-build",
        "test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Release Tests (Maven)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Pisolated-build,release-tests",
        "test"
      ],
      "group": "test",
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run All Tests (Maven, Verbose)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Pisolated-build",
        "-Dpss.walker.test.verbose=true",
        "test"
      ],
      "group": "test",
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Single Test (Maven, Verbose)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Pisolated-build",
        "-Dpss.walker.test.verbose=true",
        "-Dtest=${input:mavenTestSelector}",
        "test"
      ],
      "group": "test",
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Build Local Release JARs",
      "detail": "Pause java.autobuild.enabled before running; restore its prior value afterward, even on failure. Builds parser and docs into target/. Does not publish.",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-Prelease-tests",
        "clean",
        "verify"
      ],
      "group": "build",
      "options": {
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
