{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "mavenTestSelector",
      "type": "promptString",
      "description": "Maven test selector (Class or Class#method)",
      "default": "SqlEventWalkerSubqueriesAndClauseSemanticsTests#unaliasedDerivedSimpleAllOuterClausesV1Test"
    }
  ],
  "tasks": [
    {
      "label": "Prime Parse Build Model",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Dmaven.compiler.showWarnings=false",
        "-DskipTests",
        "test-compile"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Recover Java Model Now",
      "type": "shell",
      "command": "bash",
      "args": [
        "tools/recover-java-model.sh"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run All Tests (Maven)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run All Tests (Maven, Verbose)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Dpss.walker.test.verbose=true",
        "test"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Single Test (Maven, Verbose)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "-Dpss.walker.test.verbose=true",
        "-Dtest=${input:mavenTestSelector}",
        "test"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Clean Package (Force ANTLR)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-f",
        "parse/pom.xml",
        "clean",
        "package"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
